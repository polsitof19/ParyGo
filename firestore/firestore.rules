rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNCIONES AUXILIARES
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/empresa/$(request.auth.uid));
    }

    function isBrandAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isStaff() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isAdminOrSuper() {
      return isSuperAdmin() || isBrandAdmin();
    }

    // ==========================================
    // PÚBLICO (sin autenticación)
    // ==========================================

    // Eventos: lectura pública (necesario para portal cliente)
    // Super admin puede crear/editar cualquier evento
    // Brand admin solo eventos de sus marcas asignadas
    match /events/{eventId} {
      allow read: if true;
      allow create: if isSuperAdmin() ||
                       (isBrandAdmin() &&
                        request.resource.data.brand_id in
                        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.allowed_brands);
      allow update, delete: if isSuperAdmin() ||
                               (isBrandAdmin() &&
                                resource.data.brand_id in
                                get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.allowed_brands);
    }

    // Marcas: lectura pública (necesario para portal cliente y subdominios)
    match /brands/{brandId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() ||
                                       (isBrandAdmin() &&
                                        brandId in
                                        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.allowed_brands);
    }

    // Companies: lectura pública (compatibilidad con portal cliente)
    match /companies/{companyId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // ==========================================
    // TICKETS (requiere autenticación)
    // ==========================================

    match /tickets/{ticketId} {
      // Leer: dueño del ticket, admins o staff (links compartidos usan Cloud Function getSharedTicket)
      allow read: if isAdminOrSuper() || isStaff() ||
                     (isAuthenticated() && resource.data.user_id == request.auth.uid);

      // Crear: admins, staff, o usuario autenticado (solo sus propios tickets, precio > 0 o tipo FREE validado)
      allow create: if isAdminOrSuper() || isStaff() ||
                       (isAuthenticated() && request.resource.data.user_id == request.auth.uid &&
                        request.resource.data.price_paid >= 0);

      // Actualizar: admins, staff, o el cliente dueño (solo campos permitidos)
      allow update: if isAdminOrSuper() || isStaff() ||
                       (isAuthenticated() && resource.data.user_id == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                          ['share_token', 'share_token_created_at', 'claimed_at', 'claimed_by']
                        ));

      // Eliminar: solo admins
      allow delete: if isAdminOrSuper();
    }

    // ==========================================
    // QUOTAS (cuotas de promotores)
    // ==========================================

    match /quotas/{quotaId} {
      // Leer: admins, staff, o el promotor dueño de la cuota
      allow read: if isAdminOrSuper() || isStaff() ||
                     (isAuthenticated() && resource.data.promoter_id == request.auth.uid);

      // Crear/eliminar: solo admins
      allow create, delete: if isAdminOrSuper();

      // Actualizar: admins pueden cambiar todo, promotores solo incrementar 'used' en 1
      allow update: if isAdminOrSuper() ||
                       (isAuthenticated() && resource.data.promoter_id == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used']) &&
                        request.resource.data.used == resource.data.used + 1);
    }

    // ==========================================
    // VENTAS
    // ==========================================

    match /sales/{saleId} {
      // Leer: admins, staff, o el comprador
      allow read: if isAdminOrSuper() || isStaff() ||
                     (isAuthenticated() && resource.data.client_id == request.auth.uid);

      // Crear: autenticados (al generar venta, solo propias, con validaciones de precio)
      allow create: if isAuthenticated() &&
                       request.resource.data.client_id == request.auth.uid &&
                       request.resource.data.total_price is number &&
                       request.resource.data.total_price >= 0 &&
                       request.resource.data.quantity is int &&
                       request.resource.data.quantity >= 1 &&
                       request.resource.data.quantity <= 20;

      // Actualizar/eliminar: solo admins
      allow update, delete: if isAdminOrSuper();
    }

    // ==========================================
    // REWARDS (premios)
    // ==========================================

    match /rewards/{rewardId} {
      // Leer: autenticados (admins y promotores ven premios)
      allow read: if isAuthenticated();

      // Crear/editar/eliminar: solo admins
      allow create, update, delete: if isAdminOrSuper();
    }

    // ==========================================
    // STAFF (promotores, scanners)
    // ==========================================

    match /staff/{staffId} {
      // Leer: el propio staff o admins
      allow read: if isAuthenticated() &&
                     (request.auth.uid == staffId || isAdminOrSuper());

      // Crear/editar/eliminar: solo admins
      allow create, update, delete: if isAdminOrSuper();
    }

    // ==========================================
    // ADMINS (brand admins)
    // ==========================================

    match /admins/{adminId} {
      // Leer: el propio admin o super admin
      allow read: if isAuthenticated() &&
                     (request.auth.uid == adminId || isSuperAdmin());

      // Crear/editar/eliminar: solo super admin
      allow create, update, delete: if isSuperAdmin();
    }

    // ==========================================
    // EMPRESA (super admin)
    // ==========================================

    match /empresa/{empresaId} {
      // Leer: solo el propio super admin
      allow read: if isAuthenticated() && request.auth.uid == empresaId;

      // No se puede crear/editar/eliminar desde cliente
      allow write: if false;
    }

    // ==========================================
    // ACCESOS (control de acceso a eventos - scanner)
    // ==========================================

    match /accesos/{accesoId} {
      // Leer: solo admins y staff
      allow read: if isAdminOrSuper() || isStaff();

      // Crear: staff (al escanear entrada)
      allow create: if isStaff() || isAdminOrSuper();

      // Actualizar/eliminar: solo admins
      allow update, delete: if isAdminOrSuper();
    }

    // ==========================================
    // ACCESSES (registros de reclamo - reclamar.html)
    // ==========================================

    match /accesses/{accessId} {
      // Leer: solo admins y staff
      allow read: if isAdminOrSuper() || isStaff();

      // Crear: público con validación de esquema
      allow create: if request.resource.data.keys().hasAll(['event_id', 'code']) &&
                       request.resource.data.event_id is string &&
                       request.resource.data.code is string &&
                       request.resource.data.code.size() < 100;

      // Actualizar/eliminar: solo admins
      allow update, delete: if isAdminOrSuper();
    }

    // ==========================================
    // USER PROFILES (perfiles por marca)
    // ==========================================

    match /user_profiles/{profileId} {
      // Leer: autenticados (necesario para flujo de login)
      allow read: if isAuthenticated();

      // Crear: autenticado y solo su propio perfil
      allow create: if isAuthenticated() &&
                       request.resource.data.user_id == request.auth.uid;

      // Actualizar: el propio usuario o admins
      allow update: if isAuthenticated() &&
                       (resource.data.user_id == request.auth.uid || isAdminOrSuper());

      // Eliminar: solo admins
      allow delete: if isAdminOrSuper();
    }

    // ==========================================
    // USERS (usuarios globales)
    // ==========================================

    match /users/{userId} {
      // Leer: el propio usuario o admins
      allow read: if isAuthenticated() &&
                     (request.auth.uid == userId || isAdminOrSuper());

      // Crear/actualizar: el propio usuario
      allow create, update: if isAuthenticated() && request.auth.uid == userId;

      // Eliminar: solo admins
      allow delete: if isAdminOrSuper();
    }

    // ==========================================
    // CODES (códigos de promotores - legacy)
    // ==========================================

    match /codes/{codeId} {
      // Leer: autenticados (validación de códigos usa query por campo 'code')
      allow read: if isAuthenticated();

      // Crear: admins o staff/promotores (promotores generan códigos)
      allow create: if isAdminOrSuper() || isStaff();

      // Actualizar: admins, promotor dueño, o autenticado solo para reclamar
      allow update: if isAdminOrSuper() ||
                       (isStaff() && resource.data.promoter_id == request.auth.uid) ||
                       (isAuthenticated() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                          ['status', 'claimed_at', 'qr_token', 'claimed_by', 'claimed_name',
                           'claimed_dni', 'claimed_phone']
                        ));

      // Eliminar: solo admins
      allow delete: if isAdminOrSuper();
    }

    // ==========================================
    // PROMOTOR CODES (nuevo sistema de códigos)
    // ==========================================

    match /promotorCodes/{codeId} {
      // Lectura: admins, staff, y usuarios autenticados (para canjear códigos desde cliente.html)
      allow read: if isAdminOrSuper() || isStaff() || isAuthenticated();

      // Crear: promotores autenticados (solo sus propios códigos, campos restringidos)
      allow create: if isStaff() &&
                       request.resource.data.promoter_id == request.auth.uid &&
                       !request.resource.data.keys().hasAny(['approved_at', 'approved_by']);

      // SEC-1 FIX: Solo admins pueden aprobar pagos (status APPROVED, approved_at, approved_by)
      // Promotores pueden actualizar sus propios códigos pero NO aprobar
      // Público puede reclamar códigos (cambiar status a CLAIMED) - necesario para reclamar.html
      allow update: if isAdminOrSuper() ||
                       (isStaff() && resource.data.promoter_id == request.auth.uid &&
                        request.resource.data.status != 'APPROVED' &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved_at', 'approved_by'])) ||
                       (isAuthenticated() &&
                        request.resource.data.status == 'CLAIMED' &&
                        (resource.data.status == 'APPROVED' || resource.data.status == 'FREE' || resource.data.status == 'ACTIVE') &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                          ['status', 'claimed_at', 'qr_token', 'claimed_by', 'claimed_name',
                           'claimed_dni', 'claimed_phone']
                        ));

      // Eliminar: solo admins
      allow delete: if isAdminOrSuper();
    }

    // ==========================================
    // PROMOTOR PAYMENTS (liquidaciones de promotores)
    // ==========================================

    match /promotorPayments/{paymentId} {
      allow read: if isAdminOrSuper();
      allow create, update: if isAdminOrSuper();
      allow delete: if isAdminOrSuper();
    }

    // ==========================================
    // PURCHASES (compras/reservas)
    // ==========================================

    match /purchases/{purchaseId} {
      // Leer: el propio usuario o admins
      allow read: if isAuthenticated() &&
                     (resource.data.user_id == request.auth.uid || isAdminOrSuper());

      // Crear: autenticado y solo sus propias compras
      allow create: if isAuthenticated() &&
                       request.resource.data.user_id == request.auth.uid;

      // Actualizar: el propio usuario o admins
      allow update: if isAuthenticated() &&
                       (resource.data.user_id == request.auth.uid || isAdminOrSuper());

      // Eliminar: solo admins
      allow delete: if isAdminOrSuper();
    }

    // ==========================================
    // CLIENTES (usuarios finales del portal cliente)
    // ==========================================

    match /clientes/{clienteId} {
      // MEJORA 3: Lectura pública eliminada. searchDocument() ahora usa
      // Cloud Function (searchClientByDoc) que tiene acceso admin.
      // Lectura permitida: propio usuario, admins, o staff
      allow read: if isAuthenticated() &&
                     (resource.data.uid == request.auth.uid || isAdminOrSuper() || isStaff());

      // Crear: autenticado y el documento le pertenece (uid en datos == auth uid)
      allow create: if isAuthenticated() &&
                       request.resource.data.uid == request.auth.uid;

      // Actualizar: el propio cliente (uid en datos o ID compuesto) o admins
      allow update: if isAuthenticated() &&
                       (resource.data.uid == request.auth.uid ||
                        clienteId.matches(request.auth.uid + '_.*') ||
                        isAdminOrSuper());

      // Eliminar: solo admins
      allow delete: if isAdminOrSuper();
    }

    // ==========================================
    // ERRORS (MEJORA 6 - monitoreo de errores)
    // ==========================================

    match /errors/{errorId} {
      // Solo crear (desde cliente) con campos limitados, leer solo admins
      allow create: if request.resource.data.keys().hasOnly([
        'type', 'message', 'source', 'lineno', 'colno',
        'page', 'url', 'userAgent', 'timestamp'
      ]) && request.resource.data.message is string
        && request.resource.data.message.size() < 500;
      allow read, update, delete: if isAdminOrSuper();
    }

    // ==========================================
    // POR DEFECTO: denegar todo
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
