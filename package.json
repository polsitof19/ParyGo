{
  "name": "parygo-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:landing": "npm --workspace apps/landing run dev",
    "build:landing": "npm --workspace apps/landing run build",
    "lint:landing": "npm --workspace apps/landing run lint",
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "lint:web": "npm --workspace apps/web run lint",
    "dev": "npm run dev:web",
    "build": "npm run build:web"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
