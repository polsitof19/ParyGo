{
  "name": "parygo-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:landing": "npm --workspace apps/landing run dev",
    "build:landing": "npm --workspace apps/landing run build",
    "lint:landing": "npm --workspace apps/landing run lint",
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "lint:web": "npm --workspace apps/web run lint",
    "dev": "npm run dev:web",
    "build": "npm run build:web",
    "test:hooks": "node .claude/hooks/__tests__/run.js",
    "test:tokens": "node scripts/check-tokens-sync.js",
    "test:contrast": "node scripts/check-tokens-contrast.js && node scripts/check-brand-contrast.mjs && node scripts/check-variant-contrast.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
