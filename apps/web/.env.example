# =============================================================
# ParyGo web — environment variables
# Copy to .env.local and fill before running locally
# =============================================================

# Public site URL (used in emails, OG, links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_DOMAIN=parygo.com
NEXT_PUBLIC_SITE_NAME=ParyGo

# Supabase (project URL + anon key are public; service role is SECRET)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# Encryption key for storing per-brand MercadoPago credentials in Postgres
# 32-byte random hex (openssl rand -hex 32)
BRAND_CREDS_ENCRYPTION_KEY=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=tickets@parygo.com

# Super admin email (the only account allowed into the super admin panel)
SUPER_ADMIN_EMAIL=paulsebastian439@gmail.com

# Optional: Sentry DSN for error tracking
# SENTRY_DSN=

# Optional: WhatsApp support number used in fallback messaging
NEXT_PUBLIC_SUPPORT_WHATSAPP=56932881230
