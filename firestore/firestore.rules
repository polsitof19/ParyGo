rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNCIONES AUXILIARES
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/empresa/$(request.auth.uid));
    }

    function isBrandAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isStaff() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isAdminOrSuper() {
      return isSuperAdmin() || isBrandAdmin();
    }

    // ==========================================
    // PÚBLICO (sin autenticación)
    // ==========================================

    // Eventos: lectura pública (necesario para portal cliente), escritura solo admins
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuper();
    }

    // Marcas: lectura pública (necesario para portal cliente y subdominios)
    match /brands/{brandId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuper();
    }

    // Companies: lectura pública (compatibilidad con portal cliente)
    match /companies/{companyId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // ==========================================
    // TICKETS (requiere autenticación)
    // ==========================================

    match /tickets/{ticketId} {
      // Leer: dueño del ticket, admins o staff (links compartidos usan Cloud Function getSharedTicket)
      allow read: if isAdminOrSuper() || isStaff() ||
                     (isAuthenticated() && resource.data.user_id == request.auth.uid);

      // Crear: admins, staff, o usuario autenticado (solo sus propios tickets)
      allow create: if isAdminOrSuper() || isStaff() ||
                       (isAuthenticated() && request.resource.data.user_id == request.auth.uid);

      // Actualizar: admins, staff, o el cliente dueño del ticket
      allow update: if isAdminOrSuper() || isStaff() ||
                       (isAuthenticated() && resource.data.user_id == request.auth.uid);

      // Eliminar: solo admins
      allow delete: if isAdminOrSuper();
    }

    // ==========================================
    // QUOTAS (cuotas de promotores)
    // ==========================================

    match /quotas/{quotaId} {
      // Leer: admins, staff, o el promotor dueño de la cuota
      allow read: if isAdminOrSuper() || isStaff() ||
                     (isAuthenticated() && resource.data.promoter_id == request.auth.uid);

      // Crear/eliminar: solo admins
      allow create, delete: if isAdminOrSuper();

      // Actualizar: admins o promotor propietario de la cuota
      allow update: if isAdminOrSuper() ||
                       (isAuthenticated() && resource.data.promoter_id == request.auth.uid);
    }

    // ==========================================
    // VENTAS
    // ==========================================

    match /sales/{saleId} {
      // Leer: admins, staff, o el comprador
      allow read: if isAdminOrSuper() || isStaff() ||
                     (isAuthenticated() && resource.data.client_id == request.auth.uid);

      // Crear: autenticados (al generar venta, solo propias)
      allow create: if isAuthenticated() &&
                       request.resource.data.client_id == request.auth.uid;

      // Actualizar/eliminar: solo admins
      allow update, delete: if isAdminOrSuper();
    }

    // ==========================================
    // REWARDS (premios)
    // ==========================================

    match /rewards/{rewardId} {
      // Leer: autenticados (admins y promotores ven premios)
      allow read: if isAuthenticated();

      // Crear/editar/eliminar: solo admins
      allow create, update, delete: if isAdminOrSuper();
    }

    // ==========================================
    // STAFF (promotores, scanners)
    // ==========================================

    match /staff/{staffId} {
      // Leer: el propio staff o admins
      allow read: if isAuthenticated() &&
                     (request.auth.uid == staffId || isAdminOrSuper());

      // Crear/editar/eliminar: solo admins
      allow create, update, delete: if isAdminOrSuper();
    }

    // ==========================================
    // ADMINS (brand admins)
    // ==========================================

    match /admins/{adminId} {
      // Leer: el propio admin o super admin
      allow read: if isAuthenticated() &&
                     (request.auth.uid == adminId || isSuperAdmin());

      // Crear/editar/eliminar: solo super admin
      allow create, update, delete: if isSuperAdmin();
    }

    // ==========================================
    // EMPRESA (super admin)
    // ==========================================

    match /empresa/{empresaId} {
      // Leer: solo el propio super admin
      allow read: if isAuthenticated() && request.auth.uid == empresaId;

      // No se puede crear/editar/eliminar desde cliente
      allow write: if false;
    }

    // ==========================================
    // ACCESOS (control de acceso a eventos - scanner)
    // ==========================================

    match /accesos/{accesoId} {
      // Leer: solo admins y staff
      allow read: if isAdminOrSuper() || isStaff();

      // Crear: staff (al escanear entrada)
      allow create: if isStaff() || isAdminOrSuper();

      // Actualizar/eliminar: solo admins
      allow update, delete: if isAdminOrSuper();
    }

    // ==========================================
    // ACCESSES (registros de reclamo - reclamar.html)
    // ==========================================

    match /accesses/{accessId} {
      // Leer: solo admins y staff
      allow read: if isAdminOrSuper() || isStaff();

      // Crear: público (reclamar.html no usa Firebase Auth)
      allow create: if true;

      // Actualizar/eliminar: solo admins
      allow update, delete: if isAdminOrSuper();
    }

    // ==========================================
    // USER PROFILES (perfiles por marca)
    // ==========================================

    match /user_profiles/{profileId} {
      // Leer: autenticados (necesario para flujo de login)
      allow read: if isAuthenticated();

      // Crear: cualquier usuario autenticado
      allow create: if isAuthenticated();

      // Actualizar: el propio usuario o admins
      allow update: if isAuthenticated() &&
                       (resource.data.user_id == request.auth.uid || isAdminOrSuper());

      // Eliminar: solo admins
      allow delete: if isAdminOrSuper();
    }

    // ==========================================
    // USERS (usuarios globales)
    // ==========================================

    match /users/{userId} {
      // Leer: el propio usuario o admins
      allow read: if isAuthenticated() &&
                     (request.auth.uid == userId || isAdminOrSuper());

      // Crear/actualizar: el propio usuario
      allow create, update: if isAuthenticated() && request.auth.uid == userId;

      // Eliminar: solo admins
      allow delete: if isAdminOrSuper();
    }

    // ==========================================
    // CODES (códigos de promotores - legacy)
    // ==========================================

    match /codes/{codeId} {
      // Leer: autenticados (validación de códigos usa query por campo 'code')
      allow read: if isAuthenticated();

      // Crear: admins o staff/promotores (promotores generan códigos)
      allow create: if isAdminOrSuper() || isStaff();

      // Actualizar: autenticados (al canjear código)
      allow update: if isAuthenticated();

      // Eliminar: solo admins
      allow delete: if isAdminOrSuper();
    }

    // ==========================================
    // PROMOTOR CODES (nuevo sistema de códigos)
    // ==========================================

    match /promotorCodes/{codeId} {
      // RIESGO CONOCIDO: lectura pública necesaria para reclamar.html
      // reclamar.html NO usa Firebase Auth, hace query por campo "code"
      // sin autenticación. Firestore rules no pueden filtrar por query.
      // TODO: Migrar validación de códigos a Cloud Function para eliminar
      // lectura pública y proteger datos de clientes (claimed_by).
      allow read: if true;

      // Crear: promotores autenticados (solo sus propios códigos)
      allow create: if isStaff() &&
                       request.resource.data.promoter_id == request.auth.uid;

      // SEC-1 FIX: Solo admins pueden aprobar pagos (status APPROVED, approved_at, approved_by)
      // Promotores pueden actualizar sus propios códigos pero NO aprobar
      // Público puede reclamar códigos (cambiar status a CLAIMED) - necesario para reclamar.html
      allow update: if isAdminOrSuper() ||
                       (isStaff() && resource.data.promoter_id == request.auth.uid &&
                        request.resource.data.status != 'APPROVED' &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved_at', 'approved_by'])) ||
                       (request.resource.data.status == 'CLAIMED' &&
                        resource.data.status != 'CLAIMED' &&
                        resource.data.status != 'SCANNED' &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                          ['status', 'claimed_at', 'qr_token', 'claimed_by', 'claimed_name']
                        ));

      // Eliminar: solo admins
      allow delete: if isAdminOrSuper();
    }

    // ==========================================
    // PURCHASES (compras/reservas)
    // ==========================================

    match /purchases/{purchaseId} {
      // Leer: el propio usuario o admins
      allow read: if isAuthenticated() &&
                     (resource.data.user_id == request.auth.uid || isAdminOrSuper());

      // Crear: cualquier usuario autenticado
      allow create: if isAuthenticated();

      // Actualizar: el propio usuario o admins
      allow update: if isAuthenticated() &&
                       (resource.data.user_id == request.auth.uid || isAdminOrSuper());

      // Eliminar: solo admins
      allow delete: if isAdminOrSuper();
    }

    // ==========================================
    // CLIENTES (usuarios finales del portal cliente)
    // ==========================================

    match /clientes/{clienteId} {
      // RIESGO CONOCIDO: lectura pública necesaria para cliente.js searchDocument()
      // El flujo de login busca por doc_number ANTES de que el usuario se autentique.
      // Firestore rules no pueden restringir por campos del query.
      // TODO: Migrar searchDocument a Cloud Function para eliminar lectura pública
      // y proteger PII de clientes (nombre, DNI, email, teléfono).
      allow read: if true;

      // Crear: autenticado y el documento le pertenece (uid en datos == auth uid)
      allow create: if isAuthenticated() &&
                       request.resource.data.uid == request.auth.uid;

      // Actualizar: el propio cliente (uid en datos o ID compuesto) o admins
      allow update: if isAuthenticated() &&
                       (resource.data.uid == request.auth.uid ||
                        clienteId.matches(request.auth.uid + '_.*') ||
                        isAdminOrSuper());

      // Eliminar: solo admins
      allow delete: if isAdminOrSuper();
    }

    // ==========================================
    // POR DEFECTO: denegar todo
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
